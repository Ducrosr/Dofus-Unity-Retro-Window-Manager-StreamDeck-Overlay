{
    "name": "dofus-window-manager-streamdeck",
    "version": "0.8.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "rolldown -c rolldown.config.ts",
        "build:profiles": "python scripts/build_profiles.py",
        "test": "node --test src/appearance-preferences.test.ts src/character-selection.test.ts src/display-preferences.test.ts src/launcher.test.ts src/streamdeck-foreground.test.ts src/text-layout.test.ts src/theme.test.ts",
        "watch": "rolldown -c rolldown.config.ts -w",
        "typecheck": "tsc --noEmit",
        "validate": "streamdeck validate com.remyducros.dofuswindowmanager.sdPlugin --no-update-check",
        "pack": "streamdeck pack com.remyducros.dofuswindowmanager.sdPlugin --no-update-check --force"
    },
    "prettier": "@elgato/prettier-config",
    "dependencies": {
        "@elgato/streamdeck": "^2.0.0",
        "@elgato/utils": "^0.6.0"
    },
    "devDependencies": {
        "@elgato/cli": "^1.7.1",
        "@elgato/prettier-config": "^0.3.3",
        "@tsconfig/node20": "^20.1.2",
        "@types/node": "^20.19.0",
        "rolldown": "^1.0.0-rc.6",
        "typescript": "^5.2.2"
    }
}
